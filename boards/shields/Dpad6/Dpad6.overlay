
#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

&adc {
    #io-channel-cells = <1>;
    #address-cells = <1>;
    #size-cells = <0>;
	status = "okay";

    channel@5 {
        reg = <5>;
        zephyr,input-positive = <NRF_SAADC_AIN5>;
        zephyr,gain = "ADC_GAIN_1_6";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,resolution = <12>;
        zephyr,oversampling = <0>;
    };

    channel@7 {
        reg = <7>;
        zephyr,input-positive = <NRF_SAADC_AIN7>;
        zephyr,gain = "ADC_GAIN_1_6";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,resolution = <12>;
        zephyr,oversampling = <0>;
    };
};

/ {
    chosen {
      zmk,physical-layout = &default_layout;
    };

    kscan0: kscan_composite {
        compatible = "zmk,kscan-composite";
        rows = <4>;
        columns = <4>;

        direct_one {
            kscan = <&kscan1>;
            row-offset = <0>; // ...and shift it to not overlap
        };

        direct_two {
            kscan = <&kscan2>;
            row-offset = <1>;
        };

        direct_three {
            kscan = <&kscan3>;
            row-offset = <2>;
        };

        direct_four {
            kscan = <&kscan4>;
            row-offset = <3>;
        };
    };

    kscan1: kscan_joystick {
        compatible = "zmk,kscan-joystick";
        poll-period-ms = <4>;  /* 250Hz */
        idle-period-ms = <50>; /* 20Hz */
        angle-overlap = <30>;
        /* Increase threshold/hysteris to suppress idle jitter */
        status = "okay";
        wakeup-source;
        io-channels = <&adc 5>, <&adc 7>;
        io-channel-names = "x-axis", "y-axis";
    };

    kscan2: kscan2 {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
        input-gpios
            = 
            <&pro_micro 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&pro_micro 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&pro_micro 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;

    }; 

    kscan3: kscan3 {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
        input-gpios
            = 
            <&pro_micro 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&pro_micro 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&pro_micro 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    }; 

    kscan4: kscan4 {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
        input-gpios
            = 
            <&pro_micro 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&pro_micro 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    }; 

    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        rows = <4>;
        columns = <4>;
        // ┌───┬───┐
        // │ 1 │ 2 │ 
        // ├───┼───│
        // │ 3 │ 4 │ 
        // └───────┘
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3)
            RC(1,0) RC(1,1) RC(1,2) 
            RC(2,0) RC(2,1) RC(2,2)
            RC(3,0) RC(3,1)
        >;
    };

    
    default_layout: physical_layout0 {
        compatible = "zmk,physical-layout";
        display-name = "Default";

        transform = <&default_transform>;
        kscan = <&kscan0>;

        keys  //                     w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100    0  100       0     0     0>
            , <&key_physical_attrs 100 100  100    0       0     0     0>
            , <&key_physical_attrs 100 100  200  100       0     0     0>
            , <&key_physical_attrs 100 100  100  200       0     0     0>
            , <&key_physical_attrs 100 100  400   50       0     0     0>
            , <&key_physical_attrs 100 100  500   50       0     0     0>
            , <&key_physical_attrs 100 100  600   50       0     0     0>
            , <&key_physical_attrs 100 100  400  150       0     0     0>
            , <&key_physical_attrs 100 100  500  150       0     0     0>
            , <&key_physical_attrs 100 100  600  150       0     0     0>
            , <&key_physical_attrs 100 100  100  100       0     0     0>
            , <&key_physical_attrs  80  80  710  110       0     0     0>
            ;
    };

   
};

