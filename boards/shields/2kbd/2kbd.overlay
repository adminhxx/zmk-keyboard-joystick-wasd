
#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

&adc {
    #io-channel-cells = <1>;
    #address-cells = <1>;
    #size-cells = <0>;
	status = "okay";

    channel@5 {
        reg = <5>;
        zephyr,input-positive = <NRF_SAADC_AIN5>;
        zephyr,gain = "ADC_GAIN_1_6";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,resolution = <12>;
        zephyr,oversampling = <0>;
    };

    channel@7 {
        reg = <7>;
        zephyr,input-positive = <NRF_SAADC_AIN7>;
        zephyr,gain = "ADC_GAIN_1_6";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,resolution = <12>;
        zephyr,oversampling = <0>;
    };
};

/ {
    chosen {
      zmk,physical-layout = &default_layout;
    };

    kscan0: kscan_composite {
        compatible = "zmk,kscan-composite";
        rows = <2>;
        columns = <4>;

        // Include the direct driver
        direct {
            kscan = <&kscan1>;
        };

        // Include the direct GPIO driver...
        direct_two {
            kscan = <&kscan2>;
            row-offset = <1>; // ...and shift it to not overlap
        };
    };

    kscan1: kscan_direct {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
        input-gpios
            = 
            <&pro_micro 14 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&pro_micro 16 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&pro_micro 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };

    kscan2: kscan_joystick {
        compatible = "zmk,kscan-joystick";
        poll-period-ms = <4>;  /* 250Hz */
        idle-period-ms = <50>; /* 20Hz */
        angle-overlap = <30>;
        /* do not use a second threshold with bad quality joysticks */
        /* thresholds = [0A 78]; */
        status = "okay";
        wakeup-source;
        io-channels = <&adc 5>, <&adc 7>;
        io-channel-names = "x-axis", "y-axis";
    };


    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        rows = <2>;
        columns = <4>;
        // ┌───┬───┐
        // │ 1 │ 2 │ 
        // ├───┼───│
        // │ 3 │ 4 │ 
        // └───────┘
        map = <
            RC(0,0) RC(0,1) RC(0,2)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) 
        >;
    };

    
    default_layout: physical_layout0 {
        compatible = "zmk,physical-layout";
        display-name = "Default";

        transform = <&default_transform>;
        kscan = <&kscan0>;

        keys  //                     w   h    x    y     rot    rx    ry
            = <&key_physical_attrs  80  80  110   10       0     0     0>
            , <&key_physical_attrs 100 100    0    0       0     0     0>
            , <&key_physical_attrs 100 100    0  100       0     0     0>
            , <&key_physical_attrs 100 100    0  200       0     0     0>
            , <&key_physical_attrs 100 100  100  200       0     0     0>
            , <&key_physical_attrs 100 100  200  200       0     0     0>
            , <&key_physical_attrs 100 100  300  200       0     0     0>
            ;
    };

   
};

