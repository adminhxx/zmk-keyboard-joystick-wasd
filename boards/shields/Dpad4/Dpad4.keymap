#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>


/ {

  keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = < 
              &kp W     &kp S     &kp A     &kp D
              &kp U     &kp I     &kp J     &kp K
              &kp C_MUTE     &bt BT_CLR_ALL
            >;
        };

        bt_layer {
            bindings = <
                &kp W     &kp S     &kp A     &kp D
                &kp U     &kp I     &kp J     &kp K
                &kp C_MUTE     &bt BT_CLR_ALL
            >;
        };

        layer_3 {
            bindings = <
                &kp W     &kp D     &kp S     &kp A
              &kp U     &kp I     &kp J     &kp K
              &kp C_MUTE     &bt BT_CLR_ALL
            >;
        };
    };
};
